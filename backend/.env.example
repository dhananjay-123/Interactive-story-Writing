PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inkwell
CLIENT_URL=http://localhost:5173
# Secret used to sign auth tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Set PGSSL=true for hosted Postgres that requires SSL (Railway, Render, Neon, Supabase)
# PGSSL=true
# Email of the account to grant admin access on startup (must already be registered)
# ADMIN_EMAIL=you@example.com
